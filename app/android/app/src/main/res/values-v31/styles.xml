<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 0.26.2: o splash do Android 12+ (o ícone do app) no fundo escuro do Kenoma, claro ou escuro no sistema; depois a
         tela de carregamento do Flutter, no mesmo fundo. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/kenoma_dark</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/kenoma_dark</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
